{
  "manifest_version": 3,
  "name": "No Scroll",
  "version": "1.0.0",
  "description": "Hides feeds on Facebook, Instagram, LinkedIn, Reddit and YouTube to stop doomscrolling.",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "options.html",
    "default_title": "No Scroll",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.linkedin.com/*",
        "*://*.reddit.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "rules.js",
        "content.js"
      ],
      "css": [
        "block.css"
      ],
      "run_at": "document_start"
    }
  ]
}
